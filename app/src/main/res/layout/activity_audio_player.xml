<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/player_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:background="@null"
        android:contentDescription="@string/description_back_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow" />

    <ImageView
        android:id="@+id/track_poster"
        android:layout_width="match_parent"
        android:layout_height="321dp"
        android:layout_marginHorizontal="@dimen/dp24"
        android:layout_marginTop="@dimen/dp30"
        android:layout_marginBottom="@dimen/dp24"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_back"
        app:layout_constraintBottom_toTopOf="@id/track_name"
        app:srcCompat="@drawable/ic_track_placeholder" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"
        android:textColor="@color/txt_default"
        android:textSize="@dimen/sp22"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/track_poster"
        app:layout_constraintBottom_toTopOf="@id/track_artist"
        tools:text="Smells Like Teen Spirit" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginEnd="@dimen/dp24"
        android:layout_marginTop="@dimen/dp12"
        android:textColor="@color/txt_default"
        android:textSize="@dimen/sp14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/track_name"
        tools:text="Nirvana" />

    <ImageButton
        android:id="@+id/button_add_playlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginTop="54dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/button_play"
        app:layout_constraintTop_toBottomOf="@id/track_artist"
        android:src="@drawable/ic_button_add_playlist"
        android:background="@drawable/round_button" />

    <ImageButton
        android:id="@+id/button_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginTop="38dp"
        app:layout_constraintStart_toEndOf="@id/button_add_playlist"
        app:layout_constraintTop_toBottomOf="@id/track_artist"
        app:layout_constraintEnd_toStartOf="@id/button_add_favorite"
        android:src="@drawable/ic_button_play"
        android:background="@drawable/round_button" />

    <ImageButton
        android:id="@+id/button_add_favorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp24"
        android:layout_marginTop="54dp"
        android:layout_marginEnd="@dimen/dp24"
        app:layout_constraintStart_toEndOf="@id/button_play"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/track_artist"
        android:src="@drawable/ic_button_favorite"
        android:background="@drawable/round_button" />

<!--    <androidx.constraintlayout.widget.Barrier-->
<!--        android:id="@+id/button_barrier"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        app:barrierDirection="bottom"-->
<!--        app:constraint_referenced_ids="button_play"/>-->

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track_time_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12"
        android:layout_marginBottom="@dimen/dp17"
        android:textColor="@color/txt_default"
        android:textSize="@dimen/sp14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_play"
        tools:text="0:00" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginTop="@dimen/dp39"
        android:textColor="@color/txt_track_author"
        android:textSize="@dimen/sp13"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/track_time"
        app:layout_constraintTop_toBottomOf="@id/track_time_left"
        tools:text="Длительность" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/collection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginTop="@dimen/dp17"
        android:layout_marginBottom="@dimen/dp17"
        android:textColor="@color/txt_track_author"
        android:textSize="@dimen/sp13"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/track_collection"
        app:layout_constraintTop_toBottomOf="@id/time"
        tools:text="Альбом" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/release"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginTop="@dimen/dp17"
        android:textColor="@color/txt_track_author"
        android:textSize="@dimen/sp13"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/track_release"
        app:layout_constraintTop_toBottomOf="@id/collection"
        tools:text="Год" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/genre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginTop="@dimen/dp17"
        android:textColor="@color/txt_track_author"
        android:textSize="@dimen/sp13"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/track_genre"
        app:layout_constraintTop_toBottomOf="@id/release"
        tools:text="Жанр" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/country"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp16"
        android:layout_marginTop="@dimen/dp17"
        android:layout_marginBottom="@dimen/dp20"
        android:textColor="@color/txt_track_author"
        android:textSize="@dimen/sp13"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/track_country"
        app:layout_constraintTop_toBottomOf="@id/genre"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="Страна" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="@dimen/dp39"
        android:layout_marginEnd="@dimen/dp16"
        android:textColor="@color/txt_default"
        android:textSize="@dimen/sp13"
        app:layout_constraintStart_toEndOf="@id/time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/track_time_left"
        tools:text="0:00" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track_collection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="@dimen/dp17"
        android:layout_marginEnd="@dimen/dp16"
        android:textColor="@color/txt_default"
        android:textSize="@dimen/sp13"
        app:layout_constraintStart_toEndOf="@id/collection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/track_time"
        tools:text="Smells Like Teen Spirit" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track_release"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="@dimen/dp17"
        android:layout_marginEnd="@dimen/dp16"
        android:textColor="@color/txt_default"
        android:textSize="@dimen/sp13"
        app:layout_constraintStart_toEndOf="@id/collection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/track_collection"
        tools:text="0000" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track_genre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="@dimen/dp17"
        android:layout_marginEnd="@dimen/dp16"
        android:textColor="@color/txt_default"
        android:textSize="@dimen/sp13"
        app:layout_constraintStart_toEndOf="@id/collection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/track_release"
        tools:text="Rock" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track_country"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="@dimen/dp17"
        android:layout_marginEnd="@dimen/dp16"
        android:textColor="@color/txt_default"
        android:textSize="@dimen/sp13"
        app:layout_constraintStart_toEndOf="@id/collection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/track_genre"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="USA" />

</androidx.constraintlayout.widget.ConstraintLayout>