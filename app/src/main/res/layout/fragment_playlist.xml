<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray2"
    tools:context=".playlist.ui.fragments.PlaylistFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="10dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/screenPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/framePlaylistCover"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/playlistCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="center"
                    app:srcCompat="@drawable/ic_playlist_placeholder" />

                <ImageButton
                    android:id="@+id/playlistButtonBack"
                    android:layout_width="@dimen/dp48"
                    android:layout_height="@dimen/dp48"
                    android:layout_marginStart="@dimen/dp4"
                    android:layout_marginTop="@dimen/dp4"
                    android:background="@null"
                    android:contentDescription="@string/description_button_back"
                    app:srcCompat="@drawable/ic_arrow" />

            </FrameLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/playlistName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/ys_display_medium"
                android:textColor="@color/bg_dark_mode"
                android:textFontWeight="700"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/framePlaylistCover"
                tools:text="The Last of Us !!!" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/playlistDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/ys_display_regular"
                android:textColor="@color/bg_dark_mode"
                android:textFontWeight="400"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playlistName"
                tools:text="Beeeeeeest game" />

            <LinearLayout
                android:id="@+id/playlistTimeCountGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playlistDescription">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/playlistTime"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:drawableEnd="@drawable/ic_ellipse_black"
                    android:drawablePadding="5dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/ys_display_regular"
                    android:textColor="@color/bg_dark_mode"
                    android:textFontWeight="400"
                    android:textSize="18sp"
                    tools:text="999 минут" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/playlistTracksCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/ys_display_regular"
                    android:textColor="@color/bg_dark_mode"
                    android:textFontWeight="400"
                    android:textSize="18sp"
                    tools:text="999 треков" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/playlistShareMenuGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="19dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playlistTimeCountGroup">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/playlistShare"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:clickable="true"
                    android:scaleType="center"
                    app:srcCompat="@drawable/ic_playlist_share" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/playlistMenu"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:scaleType="center"
                    app:srcCompat="@drawable/ic_playlist_menu" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <include
        android:id="@+id/playlistBottomSheetInclude"
        layout="@layout/buttomsheet_playlist"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playlistShareMenuGroup" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>