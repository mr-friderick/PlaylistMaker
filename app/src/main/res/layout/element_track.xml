<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@color/bg_screen_default"
    android:orientation="horizontal">

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/dp45"
        android:layout_height="@dimen/dp45"
        app:cardCornerRadius="2dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/trackPoster"
            android:layout_width="@dimen/dp45"
            android:layout_height="@dimen/dp45"
            android:layout_gravity="start|center_vertical"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_track_placeholder" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/trackName"
            style="@style/text_view_track"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textColor="@color/txt_default"
            android:textSize="@dimen/sp16"
            tools:text="Smells Like Teen Spirit" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/trackArtist"
                style="@style/text_view_track"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableEnd="@drawable/ic_ellipse"
                android:drawablePadding="5dp"
                android:ellipsize="end"
                android:textColor="@color/txt_track_author"
                android:textSize="@dimen/sp11"
                tools:text="Nirvana" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/time"
                style="@style/text_view_track"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="@color/txt_track_author"
                android:textSize="@dimen/sp11"
                tools:text="0:00" />

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/searchClearIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_arrow_track" />

</LinearLayout>
