<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/media_empty_placeholder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="top|center"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_new_playlist"
        style="@style/button_search_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:layout_marginBottom="46dp"
        android:paddingHorizontal="14dp"
        android:text="@string/button_new_playlist" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_search_not_found" />

    <TextView
        style="@style/text_search_placeholder"
        android:layout_marginTop="@dimen/dp16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/playlist_empty" />
</LinearLayout>