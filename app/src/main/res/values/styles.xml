<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="toolbar_common" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">22sp</item>
        <item name="fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="toolbar_main" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="button_main">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textSize">@dimen/sp22</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="cornerRadius">@dimen/dp16</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/dp8</item>
        <item name="iconTint">@color/black</item>
    </style>
    
    <style name="view_settings">
        <item name="android:textSize">@dimen/sp16</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/txt_default</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="text_view_track">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:elevation">0dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="text_search_placeholder">
        <item name="android:textColor">@color/txt_default</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:elevation">0dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="button_search_refresh">
        <item name="android:textColor">@color/txt_button_refresh</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:elevation">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:backgroundTint">@color/button_refresh</item>
    </style>

    <style name="image_track_poster" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="playlist_cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="for_player_field_values">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@color/txt_default</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/sp13</item>
    </style>

    <style name="for_player_field_name">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:gravity">start</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/sp13</item>
    </style>

    <style name="media_tab_layout">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="tabTextColor">@color/tab_layout_color</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@color/bg_screen_default</item>
    </style>

    <style name="bnm_default">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">-15dp</item>
    </style>

    <style name="newplaylist_button">
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:elevation">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/background_button_newplaylist</item>
    </style>

    <style name="newplaylist_text">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>